# ===========================================================================
# schema:QuantitativeValue
# (IRI's cn:QuantativeValue* bewust ongewijzigd gelaten; zie toelichting)
# ===========================================================================

cn:QuantativeValueMaxCount
    a              sh:NodeShape ;
    sh:targetClass schema:QuantitativeValue ;
    sh:name        "QuantitativeValue: maximum aantal waarden"@nl ;
    sh:description "Eigenschappen die maximaal één waarde mogen hebben."@nl ;
    sh:property    [ sh:path     schema:value ;
                     sh:maxCount 1 ;
                     sh:severity sh:Warning ;
                     sh:message  "QuantitativeValue: schema:value mag maximaal één waarde hebben."@nl ] ;
.

cn:QuantativeValueType
    a              sh:NodeShape ;
    sh:targetClass schema:QuantitativeValue ;
    sh:name        "QuantitativeValue: waardetype en formaat"@nl ;
    sh:description "Eigenschappen waarvan de waarde van het juiste type moet zijn."@nl ;
    sh:property    [ sh:path     schema:value ;
                     sh:datatype xsd:decimal ;
                     sh:severity sh:Warning ;
                     sh:message  "QuantitativeValue: schema:value moet een getal (xsd:decimal) zijn."@nl ] ;
    sh:property    [ sh:path     schema:unitText ;
                     sh:datatype xsd:string ;
                     sh:severity sh:Warning ;
                     sh:message  "QuantitativeValue: schema:unitText moet tekst zonder taalcode zijn."@nl ] ;
.


# ===========================================================================
# schema:PropertyValue
# (maxCount en type samengevoegd: er wordt maar één eigenschap getoetst)
# ===========================================================================

cn:PropertyValue
    a              sh:NodeShape ;
    sh:targetClass schema:PropertyValue ;
    sh:name        "PropertyValue: aantal waarden en waardetype"@nl ;
    sh:description "schema:value moet precies één tekstwaarde zijn."@nl ;
    sh:property    [ sh:path     schema:value ;
                     sh:datatype xsd:string ;
                     sh:severity sh:Warning ;
                     sh:message  "PropertyValue: schema:value moet tekst zonder taalcode zijn."@nl ] ;
    sh:property    [ sh:path     schema:value ;
                     sh:maxCount 1 ;
                     sh:severity sh:Warning ;
                     sh:message  "PropertyValue: schema:value mag maximaal één waarde hebben."@nl ] ;
.
