    a              sh:NodeShape ;
    sh:targetClass schema:DefinedTerm ;
    sh:name        "DefinedTerm: verplichte eigenschappen"@nl ;
    sh:description "Eigenschappen die voor elke term aanwezig moeten zijn."@nl ;
    sh:property    [ sh:path     schema:name ;
                     sh:minCount 1 ;
                     sh:severity sh:Violation ;
                     sh:message  "DefinedTerm: schema:name ontbreekt."@nl ] ;
